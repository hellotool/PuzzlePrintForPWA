{
  "[typescript]": {
    "editor.defaultFormatter": "rstack.rstack"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "rstack.rstack"
  },
  "[javascript]": {
    "editor.defaultFormatter": "rstack.rstack"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "rstack.rstack"
  },
  "[json]": {
    "editor.defaultFormatter": "rstack.rstack"
  },
  "[json5]": {
    "editor.defaultFormatter": "rstack.rstack"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "rstack.rstack"
  },
  "[html]": {
    "editor.defaultFormatter": "rstack.rstack"
  },
  "[markdown]": {
    "editor.defaultFormatter": "rvben.rumdl"
  },
  "[toml]": {
    "editor.defaultFormatter": "tombi-toml.tombi"
  },
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.rslint": "always",
    "source.fixAll.rumdl": "always"
  },
  "rumdl.enable": true,
  "rumdl.configPath": "rumdl.toml",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, pnpm*, .yarnrc*, yarn*, .eslint*, eslint*, .oxlint*, oxlint*, .prettier*, prettier*, rstack.config.ts, .editorconfig, rumdl.toml",
    "rstack.config.ts": "manifest.json, localizedManifest.ts",
    "*": "${basename}.*.${extname}"
  },
  "i18n-ally.localesPaths": ["src/locales"],
  "cSpell.words": ["aaroon", "icns", "nsis", "rsbuild", "rspack", "rstack", "solidjs", "tauri", "tombi"]
}
